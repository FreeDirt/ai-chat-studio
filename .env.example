APP_NAME="AI Chat UI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8015

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ai_chat
DB_USERNAME=ai_chat_user
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# AI Provider Defaults (override via Settings UI)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
